# DXers Community Website - Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!

# ============================================================================
# Hugo Configuration
# ============================================================================

# Hugo version to use (for CI/CD and Docker)
HUGO_VERSION=0.154.1

# Hugo environment (development, production, staging)
HUGO_ENV=production

# Base URL for the site (used in production builds)
# Override this for different deployment environments
HUGO_BASEURL=https://www.dxers.ug/

# ============================================================================
# Build Configuration
# ============================================================================

# Build output directory
BUILD_OUTPUT_DIR=public

# Enable/disable minification
HUGO_MINIFY=true

# Enable/disable Git info in Hugo
HUGO_ENABLEGITINFO=true

# ============================================================================
# Development Server Configuration
# ============================================================================

# Development server port
HUGO_PORT=1313

# Development server bind address (0.0.0.0 for network access)
HUGO_BIND=127.0.0.1

# Enable/disable live reload
HUGO_LIVERELOAD=true

# Enable/disable draft content in development
HUGO_BUILDDRAFTS=false

# Enable/disable future content in development
HUGO_BUILDFUTURE=false

# ============================================================================
# Node.js Configuration
# ============================================================================

# Node environment (development, production)
NODE_ENV=production

# npm log level (silent, error, warn, info, verbose, silly)
NPM_LOGLEVEL=warn

# ============================================================================
# Git Configuration
# ============================================================================

# Git repository URL
GIT_REPO=https://github.com/DXersCommunity/dxers-site.git

# Main branch name
GIT_MAIN_BRANCH=dxers-site

# Default branch for new features
GIT_DEFAULT_BRANCH=main

# ============================================================================
# CloudFlare Pages Configuration
# ============================================================================

# CloudFlare Pages project name
CF_PAGES_PROJECT=dxers-site

# CloudFlare Pages build command
CF_BUILD_COMMAND=hugo --minify

# CloudFlare Pages output directory
CF_OUTPUT_DIR=public

# CloudFlare account ID (for API operations)
# CF_ACCOUNT_ID=your-account-id-here

# CloudFlare API token (for deployments)
# CF_API_TOKEN=your-api-token-here

# ============================================================================
# Google Analytics (Optional)
# ============================================================================

# Google Analytics ID
# Uncomment and set if you want to enable analytics
# GA_ID=UA-XXXXXXXXX-X
# or for GA4:
# GA4_ID=G-XXXXXXXXXX

# ============================================================================
# Google Custom Search (Optional)
# ============================================================================

# Google Custom Search Engine ID
# Set this to enable search functionality
GCS_ENGINE_ID=011737558837375720776:fsdu1nryfng

# ============================================================================
# Algolia DocSearch (Optional - Alternative to Google Search)
# ============================================================================

# Enable Algolia DocSearch
ALGOLIA_DOCSEARCH=false

# Algolia Application ID
# ALGOLIA_APP_ID=your-app-id

# Algolia Search API Key (public, read-only)
# ALGOLIA_SEARCH_KEY=your-search-key

# Algolia Index Name
# ALGOLIA_INDEX_NAME=dxers-docs

# ============================================================================
# Social Media Links
# ============================================================================

# Discord invite link
DISCORD_INVITE=https://discord.gg/RtG4nyCEDX

# GitHub organization URL
GITHUB_ORG=https://github.com/DXersCommunity

# GitHub repository URL
GITHUB_REPO=https://github.com/DXersCommunity/dxers-site

# Twitter handle (optional)
# TWITTER_HANDLE=@DXersCommunity

# LinkedIn page (optional)
# LINKEDIN_URL=https://www.linkedin.com/company/dxers-community

# ============================================================================
# Content Configuration
# ============================================================================

# Default content language
CONTENT_LANGUAGE=en

# Enable multi-language support
MULTILINGUAL=false

# Available languages (comma-separated)
AVAILABLE_LANGUAGES=en

# ============================================================================
# Theme Configuration
# ============================================================================

# Docsy theme version (git tag or branch)
DOCSY_VERSION=main

# Enable/disable dark mode
DARK_MODE_ENABLED=true

# Default color scheme (light, dark, auto)
DEFAULT_COLOR_SCHEME=auto

# ============================================================================
# Deployment Configuration
# ============================================================================

# Deployment method (cloudflare, netlify, vercel, manual)
DEPLOY_METHOD=cloudflare

# Deployment branch (branch to deploy from)
DEPLOY_BRANCH=dxers-site

# Enable/disable deployment previews for PRs
DEPLOY_PREVIEWS=true

# ============================================================================
# Docker Configuration
# ============================================================================

# Docker image name
DOCKER_IMAGE=dxers-site-dev

# Docker image tag
DOCKER_TAG=latest

# Docker container name
DOCKER_CONTAINER=dxers-site-container

# Docker host port
DOCKER_HOST_PORT=1313

# Docker container port
DOCKER_CONTAINER_PORT=1313

# ============================================================================
# CI/CD Configuration
# ============================================================================

# Enable/disable CI/CD
CI=false

# CI/CD provider (github-actions, gitlab-ci, circleci, travis)
CI_PROVIDER=github-actions

# Branch protection (require tests to pass)
REQUIRE_TESTS=true

# Auto-deploy on merge to main
AUTO_DEPLOY=true

# ============================================================================
# Testing Configuration
# ============================================================================

# Enable/disable HTML validation
HTML_VALIDATION=true

# Enable/disable link checking
LINK_CHECKING=true

# Enable/disable accessibility testing
A11Y_TESTING=false

# ============================================================================
# Performance Configuration
# ============================================================================

# Enable template metrics
TEMPLATE_METRICS=false

# Enable template metrics hints
TEMPLATE_METRICS_HINTS=false

# Cache directory
CACHE_DIR=resources

# Enable/disable cache
ENABLE_CACHE=true

# ============================================================================
# PostCSS Configuration
# ============================================================================

# PostCSS config file
POSTCSS_CONFIG=postcss.config.js

# Enable/disable autoprefixer
AUTOPREFIXER_ENABLED=true

# Browsers to target (for autoprefixer)
BROWSERSLIST="> 1%, last 2 versions, not dead"

# ============================================================================
# Logging and Debugging
# ============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable verbose logging
VERBOSE=false

# Enable debug mode
DEBUG=false

# ============================================================================
# Security Configuration
# ============================================================================

# Content Security Policy (CSP) header
# CSP_HEADER="default-src 'self'; script-src 'self' 'unsafe-inline';"

# Enable/disable robots.txt
ENABLE_ROBOTS_TXT=true

# Enable/disable sitemap.xml
ENABLE_SITEMAP=true

# ============================================================================
# Backup Configuration
# ============================================================================

# Backup directory
BACKUP_DIR=../backups

# Backup retention days
BACKUP_RETENTION_DAYS=30

# Enable automatic backups
AUTO_BACKUP=false

# ============================================================================
# Notification Configuration (Optional)
# ============================================================================

# Slack webhook for notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord webhook for notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# Email for notifications
# NOTIFICATION_EMAIL=notifications@dxers.ug

# ============================================================================
# Custom Variables
# ============================================================================

# Add your custom environment variables below
# CUSTOM_VAR=value
